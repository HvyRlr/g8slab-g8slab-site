---
interface Props {
  title: string;
  description: string;
  icon?: string;
  image?: string;
  cta_text?: string;
  cta_link?: string;
}

const { title, description, icon, image, cta_text, cta_link } = Astro.props;
---

<div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-2xl transition-shadow border-t-4 border-primary">
  {icon && <div class="text-5xl mb-4">{icon}</div>}
  {image && <img src={image} alt={title} class="w-full h-48 object-cover rounded mb-4" />}
  <h3 class="text-2xl font-bold mb-3 font-heading text-primary">{title}</h3>
  <p class="text-gray-600 mb-6 font-body">{description}</p>
  {cta_text && (
    <a href={cta_link || '#'} class="inline-block text-primary font-semibold hover:underline">
      {cta_text} →
    </a>
  )}
</div>
