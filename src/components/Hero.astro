---
interface Props {
  title: string;
  subtitle?: string;
  image?: string;
  cta_text?: string;
  cta_link?: string;
}

const { title, subtitle, image, cta_text, cta_link } = Astro.props;
---

<section class="bg-gradient-to-r from-primary to-secondary text-white py-20 px-4">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-12">
      <h1 class="text-6xl font-bold mb-6 font-heading">{title}</h1>
      {subtitle && <p class="text-xl opacity-90 mb-8 font-body">{subtitle}</p>}
      {cta_text && <a href={cta_link || '#'} class="inline-block bg-white text-primary px-8 py-4 rounded-lg font-semibold hover:opacity-90 transition">{cta_text}</a>}
    </div>
    {image && <img src={image} alt={title} class="w-full rounded-lg shadow-xl" />}
  </div>
</section>

<style>
  section {
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  }
</style>
