---
interface Props {
  text: string;
  link: string;
  style?: 'primary' | 'secondary' | 'outline';
}

const { text, link, style = 'primary' } = Astro.props;
---

<a href={link} class={`inline-block px-8 py-3 rounded-lg font-semibold transition ${
  style === 'primary' ? 'bg-primary text-white hover:opacity-90' :
  style === 'secondary' ? 'bg-secondary text-white hover:opacity-90' :
  'border-2 border-primary text-primary hover:bg-primary hover:text-white'
}`}>
  {text}
</a>
